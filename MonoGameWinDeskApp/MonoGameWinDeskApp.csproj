<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="CrystalGrabber.cs" />
    <Compile Remove="ExtraLifePowerUp.cs" />
    <Compile Remove="Game1.cs" />
    <Compile Remove="InvincibleBulletPowerUp.cs" />
    <Compile Remove="kamikaze.cs" />
    <Compile Remove="PepperPowerUp.cs" />
    <Compile Remove="PowerUp.cs" />
    <Compile Remove="ShieldPowerUp.cs" />
    <Compile Remove="SpeedPowerUp.cs" />
    <Compile Remove="SuperBombPowerUp.cs" />
    <Compile Remove="WobbleKamikaze.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Content\DeeperDive.jpg" />
    <None Remove="Content\OctoAnamationDistort.png" />
    <None Remove="Content\Sounds\Sound Bank.xsb" />
    <None Remove="Content\Sounds\Win\Sound Bank.xsb" />
    <None Remove="Content\Sounds\Win\Wave Bank.xwb" />
    <None Remove="Content\Sounds\Win\XACT Sounds.xgs" />
    <None Remove="Content\Sounds\XACT Sounds.xap" />
    <None Remove="Content\Sounds\XACT Sounds.xgs" />
    <None Remove="Content\XACT Sounds.xap" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.6.1" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Content\Sounds\Win\" />
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>